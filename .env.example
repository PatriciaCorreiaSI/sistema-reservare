# Chaves existentes sem revelar valores

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# No host, use 127.0.0.1, não localhost: o Windows resolve localhost
# para ::1 primeiro, e o compose publica a porta só em IPv4
DB_HOST=
# Chave que assina o JWT. Gere com:
# uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=

# Usadas só pelo coomando que cria o primeiro admin:
# uv run python -m app.comandos.criar_admin (de dentro do backend/)
# Depois de criado, ADMIN_SENHA pode sair do .env: o banco guarda só o hash.
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_SENHA=
