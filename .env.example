# valores de desenvolvimento que funcionam como estão: p .env.example .env
# São os mesmos que o .github/workflows/ci.yml já publica, e só abrem a cópia
# local, que escuta em 127.0.0.1 NUNCA use estes valores em produção: quem
# conhece o JWT_SEGREDO assina um token de admin.

POSTGRES_USER=postgres-user-test
POSTGRES_PASSWORD=postgres-password-test
POSTGRES_DB=reservare
# No host, use 127.0.0.1, não localhost: o Windows resolve localhost
# para ::1 primeiro, e o compose publica a porta só em IPv4
DB_HOST=127.0.0.1
# Chave que assina o JWT. Para qualquer ambiente fora da sua máquina, gere outra:
# uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# mínimo de 32 bytes
JWT_SEGREDO=segredo-do-ci-de-32-bytes-testes
# Fuso em que o horário de funcionamento dos recursos é lido (ADR 0018).
# Nome da IANA, não deslocamento: America/Sao_Paulo, não -03:00
FUSO_FUNCIONAMENTO=America/Sao_Paulo

# Nível mínimo das linhas de log (ADR 0029). INFO em produção; DEBUG para investigar.
# Nome do logging do Python, em maiúsculas: DEBUG, INFO, WARNING, ERROR ou CRITICAL
LOG_NIVEL=INFO

# Usadas só pelo comando que cria o primeiro admin:
# uv run python -m app.comandos.criar_admin (de dentro do backend/)
# Depois de criado, ADMIN_SENHA pode sair do .env: o banco guarda só o hash.
ADMIN_NOME=Admin
ADMIN_EMAIL=admin@reservare.example
ADMIN_SENHA=desenvolvimento
